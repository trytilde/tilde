{
  "$schema": "https://www.getbifrost.ai/schema",
  "providers": {
    "openai": {
      "keys": [
        {
          "name": "mock",
          "value": "sk-mock",
          "models": ["gpt-mock", "gpt-5-nano"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://host.docker.internal:18300",
        "default_request_timeout_in_seconds": 60,
        "max_retries": 0,
        "allow_private_network": true
      },
      "concurrency_and_buffer_size": {
        "concurrency": 64,
        "buffer_size": 256
      }
    }
  }
}
