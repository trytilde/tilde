{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@trytilde/connection-ui": ["../sdk/ts/packages/connection-ui/src/index.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom/client": ["./node_modules/@types/react-dom/client.d.ts"],
      "@trytilde/agent-avatar": ["../sdk/ts/packages/agent-avatar/src/agent-avatar.tsx"]
    }
  },
  "include": ["src"]
}
