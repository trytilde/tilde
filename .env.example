# Committed development defaults. Exported variables and .env.local take precedence.
# Packaged production startup reads only the process environment.
DATABASE_URL=postgres://engine:engine-dev@127.0.0.1:5432/engine
POSTGRES_PASSWORD=engine-dev
# One listener serves every route group; ENGINE_SERVE picks the groups this process mounts
# (management, ingress, runtime, sidecar or all). Development derives ENGINE_LISTEN from API_PORT.
ENGINE_LISTEN=127.0.0.1:8080
ENGINE_SERVE=all
# Development API and Vite ports (change WEB_PORT if 5173 is occupied).
API_PORT=8080
WEB_PORT=5173
ENGINE_ENCRYPTION_BACKEND=seed
# Public local-development seed only. Use a private key in .env.local for persistent data.
# Generate with: cargo run --bin tilde -- generate-key; retain it for existing databases.
ENGINE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Alternative: ENGINE_ENCRYPTION_BACKEND=aws-kms
# Remove ENGINE_ENCRYPTION_KEY (or leave it empty) for KMS mode.
# ENGINE_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT:key/KEY-ID
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile

# Browser-facing origin for management, OAuth callbacks and setup links; task dev defaults to the Vite origin.
# ENGINE_PUBLIC_URL=https://tilde.example.com
# Origins providers and agent hosts use when they differ from the public URL.
# ENGINE_INGRESS_PUBLIC_URL=https://events.example.com
# ENGINE_RUNTIME_PUBLIC_URL=https://runtime.example.com

# Human OIDC login (pnpm dev supplies the local Dex defaults).
ENGINE_OIDC_ISSUER=http://127.0.0.1:5556
ENGINE_OIDC_CLIENT_ID=tilde-dev
ENGINE_OIDC_CLIENT_SECRET=tilde-local-dev-secret
# Development only; production requires HTTPS.
ENGINE_OIDC_ALLOW_HTTP=true

# Development switches: management routes (ENGINE_SERVE) and React serving (embedded app or dev Vite).
ENGINE_MANAGEMENT_ENABLED=true
ENGINE_WEB_ENABLED=true

# Optional setup origin override; task dev points setup links at the Rust API.
# ENGINE_CONNECTION_SETUP_PUBLIC_URL=http://127.0.0.1:8080
# ENGINE_CONNECTION_UI_DEV_URL=http://127.0.0.1:5174

# Optional ngrok tunnel for provider webhooks (requires ngrok CLI).
# Set these in .env.local; task secrets:load can supply NGROK_AUTHTOKEN.
# NGROK_ENABLED=true
# NGROK_DOMAIN=your-domain.ngrok-free.app
# NGROK_AUTHTOKEN=your-token

# Optional dev bind/public IPv4 address; also accepts task dev ADDRESS=100.x.y.z.
# ADDRESS=100.102.116.12

# Langfuse trace storage and UI. Configure only on the gateway.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_URL=https://langfuse.example.com

# Local private avatar storage. task dev starts MinIO and creates this bucket.
# For AWS S3 set the bucket/region, remove endpoint and dedicated credentials,
# and use the normal AWS environment, profile, or task-role credential chain.
ENGINE_S3_BUCKET=tilde-avatars
ENGINE_S3_REGION=us-east-1
ENGINE_S3_ENDPOINT=http://127.0.0.1:19000
ENGINE_S3_ACCESS_KEY_ID=minioadmin
ENGINE_S3_SECRET_ACCESS_KEY=minioadmin
# Override when browsers reach S3 through a different host than the Rust server.
# ENGINE_S3_PUBLIC_ENDPOINT=https://objects.example.com
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001

# tilde-sidecar only: it dials the gateway's sidecar group and serves a loopback runtime
# listener for the agent process plus one network listener for webhooks and native ingress.
# ENGINE_SIDECAR_GATEWAY_URL=https://tilde.example.com
# ENGINE_SIDECAR_AGENT_TOKENS=<agent-one-token>,<agent-two-token>
# Optional: HTTP endpoints for agent processes that do not dial the sidecar with connectAgent.
# ENGINE_SIDECAR_AGENT_ENDPOINTS=<agent-one-id>=http://127.0.0.1:3000,<agent-two-id>=http://127.0.0.1:3001
# ENGINE_SIDECAR_CACHE_BYTES=268435456
# ENGINE_SIDECAR_THREAD_IDLE_SECONDS=86400
# ENGINE_SIDECAR_RUNTIME_LISTEN=127.0.0.1:8081
# ENGINE_SIDECAR_LISTEN=0.0.0.0:8082
# ENGINE_SIDECAR_PUBLIC_URL=https://agent-a.example.com

# Agent log history: local ClickHouse starts automatically with task dev.
DEV_LOGS_ENABLED=1
LOGS_CLICKHOUSE_PORT=18123
# Override these for an existing ClickHouse database (create the database first).
# LOGS_CLICKHOUSE_URL=https://clickhouse.example:8443
# LOGS_CLICKHOUSE_DATABASE=tilde_logs
# LOGS_CLICKHOUSE_USER=tilde
# LOGS_CLICKHOUSE_PASSWORD=your-password
# LOGS_CLICKHOUSE_CONTAINER_URL=http://logs-clickhouse:8123
# Persistent delivery directory: use a separate volume/directory for each gateway.
LOGS_QUEUE_DIR=.run/log-queue
# Optional independent OTLP/HTTP protobuf destination; include its /v1/logs path.
# LOGS_OTLP_ENDPOINT=https://collector.example/v1/logs
# LOGS_OTLP_HEADERS=Authorization=Bearer your-token
