# Committed development defaults. Exported variables and .env.local take precedence.
# Packaged production startup reads only the process environment.
DATABASE_URL=postgres://engine:engine-dev@127.0.0.1:5432/engine
POSTGRES_PASSWORD=engine-dev
ENGINE_MANAGEMENT_LISTEN=127.0.0.1:8080
# Development API and Vite ports (change WEB_PORT if 5173 is occupied).
API_PORT=8080
WEB_PORT=5173
ENGINE_ENCRYPTION_BACKEND=seed
# Public local-development seed only. Use a private key in .env.local for persistent data.
# Generate with: cargo run --bin tilde -- generate-key; retain it for existing databases.
ENGINE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Alternative: ENGINE_ENCRYPTION_BACKEND=aws-kms
# Remove ENGINE_ENCRYPTION_KEY (or leave it empty) for KMS mode.
# ENGINE_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT:key/KEY-ID
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile

# Browser-facing management origin; pnpm dev defaults to the Vite origin.
# ENGINE_MANAGEMENT_PUBLIC_URL=https://tilde.example.com

# Human OIDC login (pnpm dev supplies the local Dex defaults).
ENGINE_OIDC_ISSUER=http://127.0.0.1:5556
ENGINE_OIDC_CLIENT_ID=tilde-dev
ENGINE_OIDC_CLIENT_SECRET=tilde-local-dev-secret
# Development only; production requires HTTPS.
ENGINE_OIDC_ALLOW_HTTP=true
ENGINE_AGENT_RUNTIME_LISTEN=127.0.0.1:8081
ENGINE_AGENT_RUNTIME_PUBLIC_URL=http://127.0.0.1:8081
ENGINE_EVENT_INGRESS_LISTEN=127.0.0.1:8082
INGRESS_PORT=8082
# task dev defaults this to the ingress listener, or https://NGROK_DOMAIN when enabled.
# ENGINE_EVENT_INGRESS_PUBLIC_URL=https://events.example.com

# Independently enable management routes and React serving (embedded app or dev Vite).
ENGINE_MANAGEMENT_ENABLED=true
ENGINE_WEB_ENABLED=true

# Optional setup origin override; task dev points setup links at the Rust API.
# ENGINE_CONNECTION_SETUP_PUBLIC_URL=http://127.0.0.1:8080
# ENGINE_CONNECTION_UI_DEV_URL=http://127.0.0.1:5174

# Optional ngrok tunnel for provider webhooks (requires ngrok CLI).
# Set these in .env.local; task secrets:load can supply NGROK_AUTHTOKEN.
# NGROK_ENABLED=true
# NGROK_DOMAIN=your-domain.ngrok-free.app
# NGROK_AUTHTOKEN=your-token

# Optional dev bind/public IPv4 address; also accepts task dev ADDRESS=100.x.y.z.
# ADDRESS=100.102.116.12

# Set a destination to enable embedded Rotel forwarding; no trace payloads are stored locally.
# Exact OTLP/HTTP protobuf URL, including /v1/traces.
# ENGINE_TRACING_EXPORT_ENDPOINT=https://collector.example.com/v1/traces
# ENGINE_TRACING_EXPORT_HEADERS=Authorization=Bearer collector-token

# Local private avatar storage. task dev starts MinIO and creates this bucket.
# For AWS S3 set the bucket/region, remove endpoint and dedicated credentials,
# and use the normal AWS environment, profile, or task-role credential chain.
ENGINE_S3_BUCKET=tilde-avatars
ENGINE_S3_REGION=us-east-1
ENGINE_S3_ENDPOINT=http://127.0.0.1:19000
ENGINE_S3_ACCESS_KEY_ID=minioadmin
ENGINE_S3_SECRET_ACCESS_KEY=minioadmin
# Override when browsers reach S3 through a different host than the Rust server.
# ENGINE_S3_PUBLIC_ENDPOINT=https://objects.example.com
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
