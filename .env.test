# Committed test defaults; put private overrides in .env.test.local.
# task test starts disposable Postgres and overrides these URLs.
DATABASE_URL=postgres://engine:engine-test@127.0.0.1:5432/engine_test
TEST_DATABASE_URL=postgres://engine:engine-test@127.0.0.1:5432/engine_test
POSTGRES_PASSWORD=engine-test
ENGINE_ENCRYPTION_BACKEND=seed
ENGINE_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
# The engine requires ClickHouse; task test:run starts the local one.
ENGINE_CLICKHOUSE_URL=http://127.0.0.1:18123
ENGINE_CLICKHOUSE_USER=tilde
ENGINE_CLICKHOUSE_PASSWORD=tilde-logs-dev
