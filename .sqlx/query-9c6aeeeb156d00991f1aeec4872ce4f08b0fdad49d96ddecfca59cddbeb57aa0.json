  "query": "SELECT id, name, avatar_seed, avatar_key, paused, endpoint_url, created_at, updated_at, capabilities AS \"capabilities!: Json<Capabilities>\"\nFROM agents\nWHERE deleted_at IS NULL AND ($1::TIMESTAMPTZ IS NULL OR (created_at, id) < ($1, $2))\nAND ($4 = '' OR strpos(lower(name), lower($4)) > 0 OR id::text = $4)\nORDER BY created_at DESC, id DESC\nLIMIT $3;\n",
