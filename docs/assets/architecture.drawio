<mxfile host="drawio"><diagram id="architecture" name="Architecture"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="env" value="&lt;b&gt;Your network&lt;/b&gt; · open-source Tilde is self-hosted · everything inside is deployed and operated by you" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=14;fontColor=#334155;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1180" height="980" as="geometry"/></mxCell><mxCell id="operator" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;browser · SDK clients" style="sketch=0;outlineConnect=0;fontColor=#1F2937;dashed=0;html=1;fontSize=12;aspect=fixed;shape=mxgraph.aws4.users;fillColor=#334155;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="96" y="147" width="56" height="56" as="geometry"/></mxCell><mxCell id="proxy" value="&lt;b&gt;Reverse proxy or auth&lt;/b&gt;&lt;br&gt;you provide it" style="sketch=0;outlineConnect=0;fontColor=#1F2937;strokeColor=#ffffff;dashed=0;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;fillColor=#8C4FFF;resIcon=mxgraph.aws4.application_load_balancer;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="147" width="56" height="56" as="geometry"/></mxCell><mxCell id="agents" value="Your agents and tool hosts&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px&quot;&gt;every connection is outbound&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#334155;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="300" height="370" as="geometry"/></mxCell><mxCell id="direct" value